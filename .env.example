# Meta app — App Dashboard > Settings > Basic
META_APP_ID=
META_APP_SECRET=

# Never-expiring system user token.
# Business Settings > Users > System Users > Generate New Token.
# Scopes: ads_management, ads_read, business_management, pages_show_list,
#         pages_read_engagement, pages_manage_ads, instagram_basic, read_insights
# Omit "set_token_expires_in_60_days" so it never expires.
META_SYSTEM_USER_TOKEN=

# SIMULATE | VALIDATE | STAGE | LIVE   (default SIMULATE)
RUNTIME_MODE=SIMULATE

# --- Optional: video generation (Phase 1) ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
