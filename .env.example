# Supply these as runtime environment variables, or save provider credentials in Connections.
# npm start does not automatically load .env; Docker Compose uses APP_HOST for HTTPS.
APP_HOST=ads.your-domain.com
# For non-Compose hosting:
# APP_ORIGIN=https://ads.your-domain.com

# One Meta developer app + Facebook Login for Business User-token configuration.
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=

# Contextual ad-comment replies; select the provider/model in Engagement.
ZAI_API_KEY=
MINIMAX_API_KEY=

# Optional legacy CLI / advanced system-user connection. Assign assets and choose
# the token lifetime supported by the Meta app. See docs/FACEBOOK-LOGIN.md.
META_SYSTEM_USER_TOKEN=

# Legacy CLI default. The web workspace has a separate mode for each brand.
RUNTIME_MODE=SIMULATE
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
