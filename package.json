{
  "name": "complete-ad-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node dist/src/server/index.js",
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preflight": "node --experimental-strip-types src/cli.ts preflight",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:workflows": "node --experimental-strip-types --test test/workflows.test.ts",
    "brands": "node --experimental-strip-types src/cli.ts brands"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "yaml": "^2.6.1"
  }
}
